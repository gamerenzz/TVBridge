<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="#121212"
    android:fitsSystemWindows="true"
    android:orientation="vertical"
    android:padding="16dp">

    <TextView
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="掌上电视 · IPTV 局域网中继核心"
        android:textColor="#FFFFFF"
        android:textSize="18sp"
        android:textStyle="bold" />

    <TextView
        android:id="@+id/tvServerStatus"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="8dp"
        android:background="#1E1E1E"
        android:padding="12dp"
        android:text="服务状态: 正在初始化..."
        android:textColor="#4CAF50"
        android:textSize="13sp" />

    <!-- 快捷操作区 -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="12dp"
        android:orientation="horizontal">

        <Button
            android:id="@+id/btnCopyM3u"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:backgroundTint="#00897B"
            android:text="📋 复制 M3U 订阅源"
            android:textColor="#FFFFFF" />

        <Button
            android:id="@+id/btnMinimize"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginStart="8dp"
            android:backgroundTint="#FF8F00"
            android:text="🗕 后台运行"
            android:textColor="#FFFFFF" />

        <Button
            android:id="@+id/btnClearLogs"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginStart="8dp"
            android:backgroundTint="#424242"
            android:text="清空"
            android:textColor="#FFFFFF" />
    </LinearLayout>

    <TextView
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="14dp"
        android:text="实时中继调度与分片解密日志:"
        android:textColor="#AAAAAA"
        android:textSize="13sp" />

    <!-- 实时黑底控制台终端 -->
    <ScrollView
        android:id="@+id/logScrollView"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_marginTop="6dp"
        android:layout_weight="1"
        android:background="#000000"
        android:padding="8dp">

        <TextView
            android:id="@+id/tvConsoleLogs"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:fontFamily="monospace"
            android:textColor="#00FF66"
            android:textIsSelectable="true"
            android:textSize="11sp" />
    </ScrollView>

    <!-- 仅用于湖北台保活抓流的 1x1 隐藏容器 -->
    <LinearLayout
        android:id="@+id/hiddenWebContainer"
        android:layout_width="1dp"
        android:layout_height="1dp"
        android:orientation="vertical"
        android:visibility="invisible" />
</LinearLayout>
